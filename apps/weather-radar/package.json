{
  "name": "weather-radar",
  "version": "1.0.0",
  "license": "MIT",
  "main": "src/main.ts",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@ng-native/components": "0.22.2",
    "@ng-native/device": "0.22.2",
    "@ng-native/fabric": "0.22.2",
    "@ng-native/metro": "0.22.2",
    "@ng-native/platform": "0.22.2",
    "expo": "~58.0.25",
    "expo-file-system": "~58.0.13",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.22",
    "react": "19.3.0",
    "react-native": "0.88.1"
  },
  "devDependencies": {
    "@angular/compiler-cli": "^22.0.0",
    "@babel/core": "^7.29.7",
    "@ng-native/testing": "0.22.2",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "node scripts/start-android.mjs",
    "android:raw": "expo start --android",
    "ios": "expo start --ios",
    "web": "node -e \"console.error('This app targets iOS and Android: use npm start, npm run ios or npm run android. To render it in a browser, see https://ng-native.com/packages/web#beside-a-native-app'); process.exit(1)\"",
    "typecheck": "node metro.config.js && ngc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "weather:produce": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/weather-produce.mjs",
    "weather:serve": "node scripts/weather-serve.mjs",
    "kill": "lsof -ti:8081 | xargs -r kill"
  },
  "private": true
}
